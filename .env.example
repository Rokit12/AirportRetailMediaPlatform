# Copy to .env (docker compose reads it automatically)
LAN_IP=                  # your laptop's LAN IP so phones can open QR claim links, e.g. 192.168.1.23
WEB_PORT=8080
PUBLIC_BASE_URL=         # overrides LAN_IP, e.g. https://gateline.example.com
CURRENCY=USD
CURRENCY_SYMBOL=$
AODB_SOURCE=mock-csv     # mock-csv | vendor-api
FLIGHT_SOURCE=mock-aidx  # mock-aidx | vendor-api
ACRIS_SOURCE=mock-ngsi-ld # mock-ngsi-ld | orion-ld
AI_PROVIDER=mock         # mock | anthropic
ANTHROPIC_API_KEY=
